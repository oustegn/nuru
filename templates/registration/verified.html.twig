{% extends 'base.html.twig' %}
{% block title %}Vérification d’e-mail — Nuru{% endblock %}
{% block body %}<section class="container section"><div class="auth-card registration-result">{% if result == 'active' %}<span class="badge">COMPTE ACTIVÉ</span><h1>Votre adresse est vérifiée.</h1><p>Votre compte est actif. Vous pouvez maintenant vous connecter.</p><a class="button button-block" href="{{ path('app_login') }}">Me connecter</a>{% elseif result == 'pending' %}<span class="badge badge-peach">VALIDATION ADMIN EN ATTENTE</span><h1>Votre adresse est vérifiée.</h1><p>Votre inscription attend encore la décision d’un administrateur. Votre compte restera inactif jusqu’à son approbation.</p><a class="inline-link" href="{{ path('app_home') }}">Retour au site</a>{% else %}<h1>Ce lien n’est plus valide.</h1><p>Il est expiré, a déjà été utilisé ou a été remplacé.</p><a class="button" href="{{ path('app_resend_verification') }}">Renvoyer un lien</a>{% endif %}</div></section>{% endblock %}
