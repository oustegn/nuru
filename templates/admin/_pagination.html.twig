<nav class="admin-pagination" aria-label="Pagination"><span>Page {{ pagination.page }} sur {{ pagination.pages }}</span><div>{% if pagination.page > 1 %}<a class="button button-outline button-small" href="{{ path(app.request.attributes.get('_route'), {page: pagination.page - 1, q: q|default('')}) }}">Précédente</a>{% endif %}{% if pagination.page < pagination.pages %}<a class="button button-outline button-small" href="{{ path(app.request.attributes.get('_route'), {page: pagination.page + 1, q: q|default('')}) }}">Suivante</a>{% endif %}</div></nav>
