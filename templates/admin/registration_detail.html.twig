{% extends 'account/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}Examiner une inscription — Administration{% endblock %}
{% block workspace %}<a class="inline-link" href="{{ path('app_admin_registrations') }}">Retour aux inscriptions</a>{% for label,messages in app.flashes %}{% for message in messages %}<div class="{{ label == 'error' ? 'auth-error' : 'notice' }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}<section class="dashboard-panel"><div class="panel-heading"><h2>{{ applicant.nomComplet }}</h2><span class="badge">{{ applicant.typeInscription == 'etablissement' ? 'Représentant d’établissement' : 'Formateur' }}</span></div><dl class="profile-details"><div><dt>E-mail</dt><dd>{{ applicant.email }}</dd></div><div><dt>Vérification e-mail</dt><dd>{{ applicant.emailVerifie ? 'Vérifié le ' ~ applicant.emailVerifieLe|date('d/m/Y H:i') : 'Non vérifié' }}</dd></div><div><dt>État</dt><dd>{{ {attente:'En attente',approuve:'Approuvée',refuse:'Refusée'}[applicant.statutValidation] }}</dd></div><div><dt>Téléphone</dt><dd>{{ applicant.telephone|default('Non renseigné') }}</dd></div>{% if applicant.etablissement %}<div><dt>Établissement</dt><dd>{{ applicant.etablissement.nom }}</dd></div><div><dt>Adresse</dt><dd>{{ applicant.etablissement.adresse }}</dd></div><div><dt>Ville</dt><dd>{{ applicant.etablissement.ville }}</dd></div><div><dt>Site déclaré</dt><dd>{{ applicant.etablissement.siteWeb|default('Non renseigné') }}</dd></div>{% else %}<div><dt>Spécialité</dt><dd>{{ applicant.specialite }}</dd></div><div><dt>Présentation</dt><dd class="multiline">{{ applicant.presentation }}</dd></div>{% endif %}{% if applicant.decisionLe %}<div><dt>Décision prise le</dt><dd>{{ applicant.decisionLe|date('d/m/Y H:i') }}</dd></div><div><dt>Par</dt><dd>{{ applicant.decisionPar ? applicant.decisionPar.nomComplet : 'Administrateur supprimé' }}</dd></div>{% endif %}{% if applicant.motifRefus %}<div><dt>Motif du refus</dt><dd class="multiline">{{ applicant.motifRefus }}</dd></div>{% endif %}</dl></section>
{% if applicant.statutValidation == 'attente' %}<div class="registration-decisions"><section class="dashboard-panel"><h2>Approuver ce profil</h2><p>Confirmez que ce dossier peut rejoindre la plateforme. L’e-mail devra aussi être vérifié pour activer le compte.</p><form method="post" action="{{ path('app_admin_registration_decide', {id:applicant.id,decision:'approuver'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('registration_decision_' ~ applicant.id ~ '_approuver') }}"><button class="button" type="submit">Approuver l’inscription</button></form></section><section class="dashboard-panel"><h2>Refuser ce profil</h2><form method="post" action="{{ path('app_admin_registration_decide', {id:applicant.id,decision:'refuser'}) }}" class="auth-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('registration_decision_' ~ applicant.id ~ '_refuser') }}"><label for="refusal-reason">Motif du refus *</label><textarea id="refusal-reason" name="motif" required maxlength="2000" rows="4"></textarea><button class="button button-outline" type="submit">Refuser l’inscription</button></form></section></div>{% else %}<div class="notice">Cette inscription a déjà fait l’objet d’une décision. Aucun nouveau changement de rôle ou d’état n’est proposé ici.</div>{% endif %}{% endblock %}
