<div class="table-scroll"><table class="data-table"><thead><tr><th scope="col">Identité</th><th scope="col">Rôles</th><th scope="col">État</th><th scope="col">Création</th></tr></thead><tbody>
{% for user in users %}<tr><td><strong>{{ user.nomComplet }}</strong><small>{{ user.email }}</small></td><td>{% for role in user.roles %}{% if role != 'ROLE_USER' %}<span class="badge">{{ {ROLE_ADMIN: 'Admin', ROLE_FORMATEUR: 'Formateur', ROLE_APPRENANT: 'Apprenant', ROLE_ETABLISSEMENT: 'Établissement'}[role]|default(role) }}</span> {% endif %}{% endfor %}</td><td><span class="badge {{ user.actif ? '' : 'badge-muted' }}">{{ user.actif ? 'Actif' : 'Inactif' }}</span><small>{{ user.inscriptionPublique ? (user.emailVerifie ? 'E-mail vérifié' : 'E-mail non vérifié') : 'Compte interne' }}</small></td><td>{{ user.creeLe|date('d/m/Y') }}</td></tr>{% else %}<tr><td colspan="4">Aucun utilisateur ne correspond à votre recherche.</td></tr>{% endfor %}
</tbody></table></div>
