{% extends 'account/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}Inscriptions à valider — Administration{% endblock %}
{% block workspace %}<form method="get" class="admin-search"><label for="registration-filter">État de la demande</label><div><select id="registration-filter" name="statut">{% for value,label in {attente:'En attente',approuve:'Approuvées',refuse:'Refusées',tous:'Toutes'} %}<option value="{{ value }}" {{ pagination.status == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><button class="button button-small" type="submit">Filtrer</button></div></form><section class="dashboard-panel"><div class="panel-heading"><h2>{{ pagination.total }} demandes</h2><span class="badge badge-peach">Formateurs et établissements</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th scope="col">Demandeur</th><th scope="col">Profil</th><th scope="col">E-mail</th><th scope="col">Décision</th><th scope="col">Dossier</th></tr></thead><tbody>{% for applicant in pagination.items %}<tr><td><strong>{{ applicant.nomComplet }}</strong><small>{{ applicant.email }}</small></td><td>{{ applicant.typeInscription == 'etablissement' ? 'Établissement' : 'Formateur' }}{% if applicant.etablissement %}<small>{{ applicant.etablissement.nom }}</small>{% endif %}</td><td><span class="badge {{ applicant.emailVerifie ? '' : 'badge-peach' }}">{{ applicant.emailVerifie ? 'Vérifié' : 'À vérifier' }}</span></td><td>{{ {attente:'En attente',approuve:'Approuvée',refuse:'Refusée'}[applicant.statutValidation]|default(applicant.statutValidation) }}</td><td><a class="inline-link" href="{{ path('app_admin_registration', {id:applicant.id}) }}">Examiner {{ ui.icon('arrow') }}</a></td></tr>{% else %}<tr><td colspan="5">Aucune demande dans cet état.</td></tr>{% endfor %}</tbody></table></div><nav class="admin-pagination" aria-label="Pagination"><span>Page {{ pagination.page }} sur {{ pagination.pages }}</span><div>{% if pagination.page > 1 %}<a class="button button-outline button-small" href="{{ path('app_admin_registrations', {page:pagination.page-1,statut:pagination.status}) }}">Précédente</a>{% endif %}{% if pagination.page < pagination.pages %}<a class="button button-outline button-small" href="{{ path('app_admin_registrations', {page:pagination.page+1,statut:pagination.status}) }}">Suivante</a>{% endif %}</div></nav></section><div class="notice">Approuver une inscription sans e-mail vérifié ne permet pas la connexion : les deux conditions doivent être remplies.</div>{% endblock %}
