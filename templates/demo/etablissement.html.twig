{% extends 'demo/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}Portail établissement — Démonstration Nuru{% endblock %}
{% block dashboard %}
<div class="dashboard-heading"><div><span class="eyebrow">UNIVERSITÉ NOUVELLE AFRIQUE · ÉTABLISSEMENT FICTIF</span><h1>Votre campus, connecté<span class="greeting-dot">.</span></h1><p>Une vue d’ensemble de vos programmes et de votre activité académique.</p></div><button class="button button-small" data-demo-title="Ajouter un programme" data-demo-description="Dans le portail final, l’établissement pourra définir un BTS, une Licence, un Master, un séminaire ou une certification, puis organiser sa campagne de candidature. Aucun programme réel n’est créé ici.">Aperçu de la création {{ ui.icon('plus') }}</button></div>
<div class="stat-grid"><article class="stat-card"><span>Programmes ouverts {{ ui.icon('cap') }}</span><strong>3</strong><small>Rentrée fictive 2026–2027</small></article><article class="stat-card"><span>Candidatures reçues {{ ui.icon('file') }}</span><strong>128</strong><small>Indicateur de démonstration</small></article><article class="stat-card"><span>Admissions validées {{ ui.icon('check') }}</span><strong>86</strong><small>Décisions fictives du portail</small></article><article class="stat-card"><span>Étudiants inscrits {{ ui.icon('users') }}</span><strong>72</strong><small>Profils fictifs</small></article></div>
<div class="dashboard-columns"><section class="dashboard-panel institution-welcome"><span class="eyebrow">VOTRE IDENTITÉ, VOS PROGRAMMES</span><h2>Un espace institutionnel.<br>Une ambition collective.</h2><p>Programmes, enseignants, étudiants et évaluations : l’exemple d’un portail numérique intégré à la plateforme.</p><a class="button button-light button-small" href="{{ path('app_establishments') }}">Voir la présentation publique {{ ui.icon('arrow') }}</a></section><section class="dashboard-panel"><div class="panel-heading"><h2>Campagne d’admission</h2>{{ ui.icon('calendar') }}</div><div class="admission-step"><span>1</span><div><strong>Dépôt de candidature</strong><small>Dossier et pièces justificatives</small></div></div><div class="admission-step"><span>2</span><div><strong>Étude par l’établissement</strong><small>Vérification et décision pédagogique</small></div></div><div class="admission-step"><span>3</span><div><strong>Admission et inscription</strong><small>Frais de formation après validation</small></div></div><small class="subtle-note">Parcours prévu · aucune candidature officielle</small></section></div>
<section class="dashboard-panel" id="mes-formations"><div class="panel-heading"><h2>Mes programmes académiques</h2><span class="badge">Cohortes fictives</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Programme</th><th>Modalité</th><th>Inscrits fictifs</th><th>Statut</th><th>Présentation</th></tr></thead><tbody>{% for program in [{title: 'BTS Gestion des entreprises', slug: 'bts-gestion-entreprise', type: 'BTS', modality: 'Hybride', enrolled: 18}, {title: 'Licence Informatique & systèmes numériques', slug: 'licence-informatique', type: 'Licence', modality: 'Hybride', enrolled: 32}, {title: 'Master Management de la transformation digitale', slug: 'master-transformation-digitale', type: 'Master', modality: 'En ligne', enrolled: 22}] %}<tr><td><strong>{{ program.title }}</strong><small>{{ program.type }} · programme de démonstration</small></td><td>{{ program.modality }}</td><td>{{ program.enrolled }}</td><td><span class="badge">Exemple</span></td><td><a class="round-arrow" href="{{ path('app_course', {slug: program.slug}) }}" aria-label="Voir {{ program.title }}">{{ ui.icon('arrow') }}</a></td></tr>{% endfor %}</tbody></table></div></section>
<section class="dashboard-panel" id="suivi"><div class="panel-heading"><h2>Candidatures à examiner</h2><span class="badge badge-peach">Exemples non officiels</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Candidat fictif</th><th>Programme demandé</th><th>Dossier</th><th>Décision</th></tr></thead><tbody>{% for candidate in [{name: 'Moussa Diallo', program: 'Licence Informatique', status: 'À examiner'}, {name: 'Kadiatou Camara', program: 'Master Transformation digitale', status: 'Pièce manquante'}, {name: 'Ibrahima Barry', program: 'BTS Gestion des entreprises', status: 'À examiner'}] %}<tr><td><strong>{{ candidate.name }}</strong></td><td>{{ candidate.program }}</td><td><span class="badge {{ candidate.status == 'Pièce manquante' ? 'badge-peach' : 'badge-muted' }}">{{ candidate.status }}</span></td><td><button class="text-button" data-demo-title="Dossier de candidature fictif" data-demo-description="Le portail final permettra de consulter les pièces, demander un complément et consigner une décision d’admission selon les permissions de l’établissement. Ce template ne soumet ni ne valide aucune candidature officielle.">Aperçu du dossier {{ ui.icon('arrow') }}</button></td></tr>{% endfor %}</tbody></table></div></section>
<div class="dashboard-columns"><section class="dashboard-panel"><span class="eyebrow">GESTION FINANCIÈRE · APERÇU</span><h2>Des frais suivis, pas simulés.</h2><p>Les factures, règlements et accès pédagogiques seront reliés au système de paiement final. Aucun encaissement ou dossier financier n’est actif ici.</p><button class="inline-link" data-demo-title="Suivi administratif et financier" data-demo-description="Les frais de formation, inscriptions et paiements seront consultables dans l’espace institutionnel avec des droits adaptés. La persistance et les prestataires de paiement doivent être intégrés avant utilisation réelle.">Découvrir le fonctionnement prévu {{ ui.icon('arrow') }}</button></section><section class="dashboard-panel academic-note"><span class="icon-tile">{{ ui.icon('award') }}</span><h2>Votre souveraineté académique.</h2><p>Examens en présentiel ou à distance : vous décidez. Le jury, la validation pédagogique et l’attribution du diplôme restent sous le contrôle de votre établissement.</p><span class="badge">Aucun diplôme délivré par cette démo</span></section></div>
{% endblock %}
