{% extends 'demo/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}Mon espace apprenant — Démonstration Nuru{% endblock %}
{% block dashboard %}
<div class="dashboard-heading"><div><span class="eyebrow">CHAQUE PAS COMPTE</span><h1>Bonjour, Fatoumata<span class="greeting-dot">.</span></h1><p>Votre prochain chapitre s’écrit aujourd’hui. On continue ?</p></div><a class="button button-small" href="{{ path('app_catalog') }}">Explorer les formations {{ ui.icon('plus') }}</a></div>
<div class="stat-grid"><article class="stat-card"><span>Formations en cours {{ ui.icon('book') }}</span><strong>3</strong><small>Votre parcours de démonstration</small></article><article class="stat-card"><span>Heures d’apprentissage {{ ui.icon('clock') }}</span><strong>24<span> h</span></strong><small>Activité fictive du mois</small></article><article class="stat-card"><span>Progression moyenne {{ ui.icon('chart') }}</span><strong>58<span>%</span></strong><small>Exemple d’indicateur pédagogique</small></article><article class="stat-card"><span>Objectif hebdomadaire {{ ui.icon('award') }}</span><strong>3<span> / 4 h</span></strong><small>Encore un pas vers votre objectif</small></article></div>
<div class="dashboard-columns"><section class="dashboard-panel continue-panel"><div><span class="badge">REPRENDRE MON APPRENTISSAGE</span><h2>Votre prochain déclic<br>est à une leçon d’ici.</h2><p>Développement web avec Symfony</p><span class="lesson-label">Module 3 · Twig et les interfaces web</span><button class="button button-light button-small" data-demo-title="Aperçu : Twig et les interfaces web" data-demo-description="Cette leçon fictive présente l’héritage de templates, les blocs Twig et les composants réutilisables. Dans le produit final, cet espace comprendra une vidéo, des ressources et un suivi de progression.">Aperçu de ma leçon {{ ui.icon('video') }}</button></div><div class="progress-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="50"/><circle cx="60" cy="60" r="50"/></svg><div><strong>65<span>%</span></strong><small>du parcours</small></div></div></section><section class="dashboard-panel next-session"><span class="eyebrow">À VOTRE AGENDA</span><div class="session-date"><strong>16</strong><span>NOV.</span></div><h3>Atelier Power BI</h3><p>{{ ui.icon('clock') }} 10 h 00 — 12 h 00</p><p>{{ ui.icon('pin') }} Conakry · session fictive</p><button class="inline-link" data-demo-title="Votre session de démonstration" data-demo-description="Atelier d’initiation Power BI, le 16 novembre 2026, de 10 h à 12 h. Dans la plateforme finale, vous recevrez l’adresse précise et un rappel. Aucun événement réel n’est réservé.">Détails de la session {{ ui.icon('arrow') }}</button></section></div>
<section class="dashboard-panel" id="mes-formations"><div class="panel-heading"><h2>Mes formations</h2><span class="badge badge-muted">3 parcours fictifs</span></div><div class="learning-list">{% for course in courses %}{% set progress = [65, 80, 30][loop.index0] %}<article><img src="{{ course.image }}" alt="" width="160" height="100"><div class="learning-list-copy"><span class="eyebrow">{{ course.domain }}</span><h3>{{ course.title }}</h3><span>{{ course.provider }}</span><div class="course-progress"><div><i style="width: {{ progress }}%"></i></div><strong>{{ progress }} %</strong></div></div><a class="round-arrow" href="{{ path('app_course', {slug: course.slug}) }}" aria-label="Voir {{ course.title }}">{{ ui.icon('arrow') }}</a></article>{% endfor %}</div></section>
<div class="dashboard-columns" id="suivi"><section class="dashboard-panel"><div class="panel-heading"><h2>Des acquis à consolider</h2>{{ ui.icon('check') }}</div><p>Vérifiez une notion avec un mini-quiz d’entraînement.</p><div class="quiz-preview"><span class="icon-tile">{{ ui.icon('code') }}</span><div><h3>Les bases de Twig</h3><p>1 question · entraînement non enregistré</p></div></div><button class="button button-outline button-small" data-open-dialog="quiz-dialog">Essayer le quiz {{ ui.icon('arrow') }}</button></section><section class="dashboard-panel"><div class="panel-heading"><h2>Mes ressources & certificats</h2>{{ ui.icon('award') }}</div><div class="resource-line"><span>{{ ui.icon('file') }} Guide Symfony · exemple</span><button class="text-button" data-demo-title="Ressource pédagogique" data-demo-description="Le formateur ajoutera ici ses documents PDF, fiches pratiques et exercices. Ce guide est un emplacement illustratif, pas un fichier de cours disponible.">Aperçu</button></div><div class="resource-line"><span>{{ ui.icon('award') }} Certificat de réussite · exemple</span><button class="text-button" data-demo-title="Exemple de certificat non officiel" data-demo-description="Les certificats finaux pourront afficher le nom de l’apprenant, la formation et les critères de réussite. Aucun certificat officiel ou preuve de qualification n’est délivré par cette démonstration.">Aperçu</button></div></section></div>
<dialog id="quiz-dialog" class="modal" aria-labelledby="quiz-title"><button class="dialog-close icon-button" data-close-dialog aria-label="Fermer">{{ ui.icon('close') }}</button><span class="badge">QUIZ D’ENTRAÎNEMENT · DÉMO</span><h2 id="quiz-title">Les bases de Twig</h2><p>À quoi sert principalement Twig dans une application Symfony ?</p><form id="demo-quiz"><label class="quiz-answer"><input type="radio" name="answer" value="database" required> À stocker les données dans une base</label><label class="quiz-answer"><input type="radio" name="answer" value="templates"> À générer des pages à partir de templates</label><label class="quiz-answer"><input type="radio" name="answer" value="payments"> À traiter les paiements mobiles</label><button class="button" type="submit">Vérifier ma réponse {{ ui.icon('check') }}</button><p class="quiz-result" id="quiz-result" role="status"></p></form><small class="subtle-note">Entraînement fictif. Le résultat n’est pas enregistré et ne délivre aucune certification.</small></dialog>
{% endblock %}
