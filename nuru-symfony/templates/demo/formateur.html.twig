{% extends 'demo/layout.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}Mon espace formateur — Démonstration Nuru{% endblock %}
{% block dashboard %}
<div class="dashboard-heading"><div><span class="eyebrow">TRANSMETTEZ CE QUI VOUS ANIME</span><h1>Bonjour, Mamadou<span class="greeting-dot">.</span></h1><p>Vos savoirs font grandir les talents. Voici votre activité fictive.</p></div><button class="button button-small" data-demo-title="Créer une formation" data-demo-description="L’espace final permettra de définir un titre, des objectifs, un tarif, puis d’organiser des modules avec vidéos, PDF et quiz avant publication. La création et la publication ne sont pas actives dans ce template.">Aperçu de la création {{ ui.icon('plus') }}</button></div>
<div class="stat-grid"><article class="stat-card"><span>Formations publiées {{ ui.icon('book') }}</span><strong>3</strong><small>Catalogue fictif du formateur</small></article><article class="stat-card"><span>Apprenants inscrits {{ ui.icon('users') }}</span><strong>42</strong><small>Profils de démonstration</small></article><article class="stat-card"><span>Ventes brutes {{ ui.icon('money') }}</span><strong class="stat-money">10 000 000<span> GNF</span></strong><small>Montant d’exemple</small></article><article class="stat-card"><span>Votre part · 85 % {{ ui.icon('chart') }}</span><strong class="stat-money">8 500 000<span> GNF</span></strong><small>Aucun versement réel</small></article></div>
<section class="dashboard-panel" id="mes-formations"><div class="panel-heading"><h2>Mes formations</h2><span class="badge">Gestion pédagogique · démo</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Formation</th><th>Modules</th><th>Apprenants fictifs</th><th>Statut</th><th>Aperçu</th></tr></thead><tbody>{% for course in courses %}<tr><td><div class="table-course"><img src="{{ course.image }}" alt="" width="64" height="44"><div><strong>{{ course.title }}</strong><small>{{ course.price|number_format(0, ',', ' ') }} GNF · tarif fictif</small></div></div></td><td>{{ course.modules|length }}</td><td>{{ [18, 16, 8][loop.index0] }}</td><td><span class="badge">Publié · exemple</span></td><td><a class="round-arrow" href="{{ path('app_course', {slug: course.slug}) }}" aria-label="Voir {{ course.title }}">{{ ui.icon('arrow') }}</a></td></tr>{% endfor %}</tbody></table></div></section>
<div class="dashboard-columns"><section class="dashboard-panel"><div class="panel-heading"><h2>Vos contenus, bien organisés</h2>{{ ui.icon('file') }}</div><p>Exemple de structure pédagogique pour « Développement web avec Symfony ».</p><div class="content-module"><span class="module-number">01</span><div><strong>Les fondamentaux de PHP moderne</strong><small>Vidéo · Document PDF · Quiz général</small></div><span class="badge">Exemple</span></div><div class="content-module"><span class="module-number">02</span><div><strong>Premiers pas avec Symfony</strong><small>Vidéo · Exercice pratique · Discussion</small></div><span class="badge">Exemple</span></div><button class="inline-link" data-demo-title="Vidéos, documents et évaluations" data-demo-description="Les futurs outils permettront d’ajouter et de protéger vos vidéos, de téléverser des PDF, de créer un quiz général et de définir les conditions de délivrance d’un certificat ou d’une attestation. Aucun téléversement ni certificat réel n’est créé ici.">Aperçu des outils pédagogiques {{ ui.icon('arrow') }}</button></section><section class="dashboard-panel revenue-panel"><span class="eyebrow">UNE RÉPARTITION TRANSPARENTE</span><h2>Votre expertise, valorisée.</h2><div class="revenue-bar"><i></i></div><div class="revenue-breakdown"><span><i></i> Votre part <strong>85 %</strong></span><span><i></i> Plateforme <strong>15 %</strong></span></div><div class="money-row"><span>Ventes brutes fictives</span><strong>10 000 000 GNF</strong></div><div class="money-row"><span>Commission plateforme · 15 %</span><strong>1 500 000 GNF</strong></div><div class="money-row total"><span>Votre part · 85 %</span><strong>8 500 000 GNF</strong></div><small>Exemple de calcul. Aucun paiement, reversement ou solde réel.</small></section></div>
<section class="dashboard-panel" id="suivi"><div class="panel-heading"><h2>Le suivi de mes apprenants</h2><span class="badge badge-muted">Profils fictifs</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Apprenant</th><th>Formation</th><th>Progression</th><th>Accès</th></tr></thead><tbody>{% for student in [{name: 'Fatoumata Barry', initials: 'FB', progress: 65}, {name: 'Alpha Condé', initials: 'AC', progress: 40}, {name: 'Mariama Diallo', initials: 'MD', progress: 90}] %}<tr><td><div class="table-person"><span class="profile-avatar">{{ student.initials }}</span><strong>{{ student.name }}</strong></div></td><td>Développement web avec Symfony</td><td><div class="table-progress"><span style="width: {{ student.progress }}%"></span></div><small>{{ student.progress }} % · exemple</small></td><td><button class="text-button" data-demo-title="Gestion des accès apprenants" data-demo-description="Le formateur pourra consulter les inscriptions, les paiements et la progression, puis gérer l’accès aux contenus selon ses permissions. Ces profils et accès sont fictifs.">Aperçu</button></td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
