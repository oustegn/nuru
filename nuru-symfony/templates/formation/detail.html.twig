{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as ui %}
{% block title %}{{ course.title }} — Nuru{% endblock %}
{% block description %}{{ course.description|slice(0, 150) }}{% endblock %}
{% block body %}
<section class="detail-intro"><div class="container"><div class="breadcrumb"><a href="{{ path('app_home') }}">Accueil</a>{{ ui.icon('chevron') }}<a href="{{ path('app_catalog') }}">Formations</a>{{ ui.icon('chevron') }}<span>{{ course.domain }}</span></div><div class="detail-heading"><div><div class="course-kicker"><span class="badge">{{ course.program }}</span><span class="badge badge-outline">{{ course.modality }}</span><span class="detail-level">{{ course.level }}</span></div><h1>{{ course.title }}</h1><p>{{ course.description }}</p><span class="provider-line">{{ ui.icon('building') }} {{ course.provider }} <small>· Partenaire fictif</small></span></div></div></div></section>
<section class="container detail-layout">
    <div class="detail-main">
        <div class="detail-stats"><span>{{ ui.icon('clock') }}<strong>{{ course.duration }}</strong><small>{{ course.hours }} heures d’exemple</small></span><span>{{ ui.icon('book') }}<strong>{{ course.modules|length }} modules</strong><small>Un parcours structuré</small></span><span>{{ ui.icon('award') }}<strong>{{ course.program == 'Certification' ? 'Certificat' : 'Parcours académique' }}</strong><small>Exemple non officiel</small></span></div>
        <section class="detail-section"><span class="eyebrow">DES OBJECTIFS CONCRETS</span><h2>Ce que vous allez apprendre.</h2><ul class="objective-list">{% for objective in course.objectives %}<li>{{ ui.icon('check') }}{{ objective }}</li>{% endfor %}</ul></section>
        <section class="detail-section"><span class="eyebrow">PAS À PAS, ALLEZ PLUS LOIN</span><h2>Votre programme de formation.</h2><div class="module-list">{% for module in course.modules %}<details {{ loop.first ? 'open' : '' }}><summary><span class="module-number">{{ '%02d'|format(loop.index) }}</span><strong>{{ module }}</strong>{{ ui.icon('plus') }}</summary><div><p>Découvrez les notions essentielles, mettez-les en pratique et vérifiez vos acquis.</p><span>{{ ui.icon('video') }} Leçons vidéo</span><span>{{ ui.icon('file') }} Ressources PDF</span><span>{{ ui.icon('check') }} Quiz d’entraînement</span><small>Contenu de démonstration : les vidéos et exercices réels seront ajoutés par le formateur.</small></div></details>{% endfor %}</div></section>
        <section class="teacher-block"><span class="teacher-avatar">{{ course.teacher|slice(0, 1) }}</span><div><span class="eyebrow">VOTRE ACCOMPAGNEMENT</span><h3>{{ course.teacher }}</h3><p>Profil pédagogique fictif pour illustrer l’interface formateur.</p></div></section>
        {% if course.program != 'Certification' %}<div class="notice">{{ ui.icon('cap') }} Le jury, la validation pédagogique et la délivrance du diplôme restent sous le contrôle de l’établissement. Ce programme fictif ne constitue pas une offre de diplôme accréditée.</div>{% endif %}
    </div>
    <aside class="enrollment-card"><img src="{{ course.image }}" alt="Illustration du domaine de formation" width="640" height="360"><div class="enrollment-body"><span class="eyebrow">INVESTISSEZ DANS VOTRE AVENIR</span><div class="detail-price">{{ course.price|number_format(0, ',', ' ') }} <small>GNF</small></div><p class="subtle-note">Tarif fictif{% if course.program != 'Certification' %} par année{% endif %} · démonstration</p>
    {% if course.location is defined %}<div class="session-info"><span class="badge {{ course.status == 'Terminé' ? 'badge-muted' : '' }}">{{ course.status }}</span><p>{{ ui.icon('pin') }} {{ course.location }}</p><p>{{ ui.icon('calendar') }} {{ course.dates }}</p><p>{{ ui.icon('users') }} {{ course.places }} place{{ course.places != 1 ? 's' : '' }} disponible{{ course.places != 1 ? 's' : '' }} · exemple</p></div>{% endif %}
    {% if course.status == 'Terminé' %}<button class="button button-block button-outline" data-demo-title="Cette session est terminée" data-demo-description="Cette session fictive est terminée. Dans la plateforme finale, vous pourrez recevoir une alerte pour une prochaine session.">Voir les prochaines sessions {{ ui.icon('calendar') }}</button>{% elseif course.status == 'En cours' and course.places|default(1) == 0 %}<button class="button button-block" data-demo-title="Candidature pour une prochaine rentrée" data-demo-description="La cohorte fictive est en cours et ne dispose plus de places. Le portail final permettra de candidater à une prochaine rentrée, avec étude du dossier par l’établissement.">Préparer ma candidature {{ ui.icon('arrow') }}</button>{% else %}<button class="button button-block" data-demo-title="Votre inscription, étape par étape" data-demo-description="Dans la plateforme finale, vous créerez votre compte, compléterez votre inscription ou votre candidature, puis réglerez les frais via une solution de paiement intégrée. Aucun dossier, paiement ou accès payant n’est créé dans cette démonstration.">{{ course.program == 'Certification' ? 'M’inscrire à cette formation' : 'Déposer ma candidature' }} {{ ui.icon('arrow') }}</button>{% endif %}
    <ul class="included-list"><li>{{ ui.icon('check') }} Accès adapté à votre modalité</li><li>{{ ui.icon('check') }} Ressources pédagogiques</li><li>{{ ui.icon('check') }} Suivi de la progression</li><li>{{ ui.icon('check') }} Accompagnement pédagogique</li></ul><a class="inline-link" href="{{ path('app_demo', {role: 'apprenant'}) }}">Explorer l’espace apprenant {{ ui.icon('arrow') }}</a><small class="secure-note">Template · aucun paiement actif</small></div></aside>
</section>
{% endblock %}
