# Copier ce fichier en .env.dev. Le fichier de base .env doit contenir APP_ENV=dev.
APP_DEBUG=0
CATALOG_SOURCE=database
SITE_PUBLIC_ORIGIN=
# Les valeurs personnelles vont dans .env.dev.local, exclu de Git.
# Adapter serverVersion à la valeur SELECT VERSION() de votre serveur MySQL.
DATABASE_URL="mysql://nuru_app:CHANGE_ME@127.0.0.1:3306/nuru?serverVersion=8.0.0&charset=utf8mb4"
