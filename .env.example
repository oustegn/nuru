APP_ENV=dev
APP_DEBUG=0
# Remplacer par une valeur aléatoire avant toute utilisation en production.
APP_SECRET=replace-this-template-secret
# Laisser vide avant de configurer le domaine public final.
SITE_PUBLIC_ORIGIN=

# Choisir database après configuration et migrations MySQL.
CATALOG_SOURCE=demo
DATABASE_URL="mysql://nuru_app:CHANGE_ME@127.0.0.1:3306/nuru?serverVersion=8.0.0&charset=utf8mb4"

# Localhost HTTP ; pour un aperçu HTTPS intégré : 1 et none.
SESSION_SECURE=0
SESSION_SAMESITE=lax

# Vérification e-mail : configurer un transport local de test ou SMTP.
# null://null désactive l'envoi ; les comptes restent inactifs jusqu'à vérification.
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.invalid
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
